{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectWise work item",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "school": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{2,16}$"
    },
    "site": {
      "type": "string",
      "description": "Optional exact Site; must agree with the confirmed school mapping, or configured default for unmapped schools."
    },
    "issue": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "existingTicketId": {
      "type": "integer",
      "minimum": 1
    },
    "titleContains": {
      "type": "string",
      "minLength": 1
    },
    "timeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "start",
        "end",
        "notes",
        "workType",
        "workRole",
        "billable"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "workType": {
          "type": "string",
          "minLength": 1
        },
        "workRole": {
          "type": "string",
          "minLength": 1
        },
        "billable": {
          "enum": [
            "B",
            "NB",
            "NC",
            "AUTO"
          ]
        },
        "location": {
          "type": "string"
        },
        "businessUnit": {
          "type": "string"
        },
        "agreement": {
          "type": "string"
        },
        "ticketStatus": {
          "type": "string"
        },
        "addNoteTo": {
          "enum": [
            "Discussion",
            "Internal",
            "Resolution"
          ]
        }
      }
    }
  }
}
