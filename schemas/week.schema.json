{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectWise weekly work plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["weekStart", "items"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "exampleOnly": { "type": "boolean", "description": "True for documentation examples; execution must refuse submission" },
    "timeZone": { "const": "America/New_York" },
    "weekStart": { "type": "string", "format": "date", "description": "Monday of the week" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timeEntries"],
        "properties": {
          "recordId": { "type": "string", "minLength": 1, "description": "Stable ID from the voice tool for this issue" },
          "school": { "type": "string", "pattern": "^[A-Za-z0-9]{2,16}$" },
          "site": { "type": "string", "const": "Example Public Schools", "description": "Optional; all tickets use the company-wide Site" },
          "issue": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "finalStatus": { "type": "string" },
          "endOfDayNotes": { "type": "string" },
          "nextStep": { "type": "string" },
          "context": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "building": { "type": "string" },
              "room": { "type": "string" },
              "asset": { "type": "string" },
              "people": { "type": "array", "items": {
                "type": "object", "additionalProperties": false, "required": ["name", "role"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "email": { "type": "string", "format": "email" },
                  "role": { "enum": ["reportedBy", "affected", "assisted"] }
                }
              } }
            }
          },
          "titleContains": { "type": "string", "minLength": 1, "description": "Literal substring of an existing title; zero or multiple matches stop without creating a ticket" },
    "existingTicketId": { "type": "integer", "minimum": 1 },
          "sourceRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "timeEntries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["date", "start", "end", "notes", "workType", "workRole", "billable"],
              "properties": {
                "recordId": { "type": "string", "minLength": 1, "description": "Stable ID from the voice tool for this time entry" },
                "date": { "type": "string", "format": "date" },
                "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
                "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
                "notes": { "type": "string", "minLength": 1 },
                "workType": { "type": "string", "minLength": 1 },
                "workRole": { "type": "string", "minLength": 1 },
                "billable": { "enum": ["B", "NB", "NC", "AUTO"] },
                "location": { "type": "string" },
                "businessUnit": { "type": "string" },
                "agreement": { "type": "string" },
                "ticketStatus": { "type": "string" },
                "addNoteTo": { "enum": ["Discussion", "Internal", "Resolution"] },
                "workFacts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "outcome": { "type": "string" },
                "followUp": { "type": "string" },
                "sourceRecordIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
              }
            }
          }
        }
      }
    }
  }
}




