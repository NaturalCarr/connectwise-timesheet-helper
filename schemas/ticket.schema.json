{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectWise daily ticket work record",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "exampleOnly": { "type": "boolean" },
    "recordId": { "type": "string", "minLength": 1 },
    "school": { "type": "string", "pattern": "^[A-Za-z0-9]{2,16}$" },
    "issue": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "site": { "const": "Example Public Schools" },
    "titleContains": { "type": "string", "minLength": 1, "description": "Literal substring of an existing title; zero or multiple matches stop without creating a ticket" },
    "existingTicketId": { "type": "integer", "minimum": 1 },
    "finalStatus": { "type": "string", "description": "Selected supported ticket status after saving time" },
    "completeAfterTime": { "type": "boolean" },
    "timeEntries": { "type": "array", "minItems": 1, "items": { "$ref": "#/properties/timeEntry" } },
    "timeEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "start", "end", "notes", "workType", "workRole", "billable"],
      "properties": {
        "recordId": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "notes": { "type": "string", "minLength": 1 },
        "workType": { "type": "string", "minLength": 1 },
        "workRole": { "type": "string", "minLength": 1 },
        "billable": { "enum": ["B", "NB", "NC", "AUTO"] },
        "location": { "type": "string" },
        "businessUnit": { "type": "string" },
        "agreement": { "type": "string" },
        "ticketStatus": { "type": "string" },
        "addNoteTo": { "enum": ["Discussion", "Internal", "Resolution"] }
      }
    }
  }
}





